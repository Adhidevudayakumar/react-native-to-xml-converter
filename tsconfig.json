{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2020",
        "moduleResolution": "Node",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "lib": [
            "ES2020"
        ],
        "esModuleInterop": true,
        "strict": true
    },
    "include": [
        "src"
    ]
}